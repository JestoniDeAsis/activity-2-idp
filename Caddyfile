{
	# Do not use port 80 (it may be taken by XAMPP/Apache).
	auto_https disable_redirects
}

localhost:8443 {
	# Certificate from Caddy's own local authority (browsers trust it after Step 4).
	tls internal {
		# TLS 1.3 only, as the PDF asks.
		protocols tls1.3
	}

	# Pass everything to the Laravel server.
	reverse_proxy 127.0.0.1:8000
}